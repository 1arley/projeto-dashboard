# ============================================================
# .env — Configurações de ambiente
# Para desenvolvimento: cp .env.example .env (funciona como está)
# Para produção: altere SECRET_KEY, POSTGRES_PASSWORD e DB_PASSWORD
# ============================================================

# --- Django ---
SECRET_KEY=django-insecure-dev-only-change-in-prod
DEBUG=true
ALLOWED_HOST=localhost
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=electricity_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
DB_NAME=electricity_db
DB_USER=admin
DB_PASSWORD=adminpassword
DB_HOST=db
DB_PORT=5432

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/
VITE_PROXY_TARGET=http://web:8000
