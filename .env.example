# ============================================================
# .env.example — Copiar para .env e preencher os valores
# ============================================================

# --- Django ---
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=false
ALLOWED_HOST=your-domain.com
CORS_ORIGIN=https://your-domain.com

# --- PostgreSQL ---
POSTGRES_DB=electricity_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-to-a-strong-password
DB_NAME=electricity_db
DB_USER=admin
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=db
DB_PORT=5432

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/
VITE_PROXY_TARGET=http://web:8000
